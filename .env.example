# Copy to .env.local. For local work, run `npm run db:start` and take these
# two values from its output: API_URL and PUBLISHABLE_KEY (the `sb_publishable_`
# one, not the legacy ANON_KEY JWT).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Used only by the database tests in e2e/ for now: SECRET_KEY and DB_URL from
# the same output. Never prefix the secret key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
