# Copy to .env.local. For local work, run `npm run db:start` and take these
# two values from its output: API_URL and PUBLISHABLE_KEY (the `sb_publishable_`
# one, not the legacy ANON_KEY JWT).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET_KEY from the same output. The server uses it only to send staff invite
# emails (utils/supabase/admin.ts); the database tests in e2e/ use it too. Never
# prefix it with NEXT_PUBLIC_, or Next.js ships it to every browser.
SUPABASE_SECRET_KEY=

# DB_URL from the same output. Used only by the database tests in e2e/.
SUPABASE_DB_URL=
