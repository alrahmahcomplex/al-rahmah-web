# Copy to .env.local, or run `npm run env:local` with local Supabase running
# (`npm run db:start`) to fill in the four values below from its output.
# For the first two, by hand: API_URL and PUBLISHABLE_KEY (the `sb_publishable_`
# one, not the legacy ANON_KEY JWT).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRET_KEY from the same output. The server uses it only to send staff invite
# emails (utils/supabase/admin.ts); the database and browser tests use it too.
# Never prefix it with NEXT_PUBLIC_, or Next.js ships it to every browser.
SUPABASE_SECRET_KEY=

# DB_URL from the same output. Used only by the tests (tests/support/db.ts).
SUPABASE_DB_URL=
